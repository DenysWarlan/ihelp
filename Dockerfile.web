FROM node:24-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

RUN npx nx build web --configuration=production

# --- Serve with nginx ---
FROM nginx:alpine

COPY --from=builder /app/dist/apps/web/browser /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80

# Extract DNS resolver from /etc/resolv.conf at container start
CMD ["sh", "-c", "NS=$(grep nameserver /etc/resolv.conf | head -1 | awk '{print $2}'); case \"$NS\" in *:*) NS=\"[$NS]\";; esac; export NGINX_RESOLVER=$NS && /docker-entrypoint.sh nginx -g 'daemon off;'"]
