FROM node:24-slim AS builder

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Copy source
COPY . .

# Generate Prisma client
RUN cd libs/prisma-client && npx prisma generate

# Build API
RUN npx nx build api

# Install only production dependencies in a separate layer
RUN cp -r node_modules node_modules_full && \
    rm -rf node_modules && \
    npm ci --omit=dev && \
    cp -r node_modules_full/.prisma node_modules/.prisma && \
    cp -r node_modules_full/@prisma node_modules/@prisma && \
    rm -rf node_modules_full

# --- Production stage ---
FROM node:24-slim

RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy production node_modules only
COPY --from=builder /app/node_modules ./node_modules

# Copy Prisma schema + config for migrations
COPY --from=builder /app/libs/prisma-client/prisma ./libs/prisma-client/prisma
COPY --from=builder /app/libs/prisma-client/tsconfig.json ./libs/prisma-client/tsconfig.json

# Copy built API
COPY --from=builder /app/apps/api/dist ./dist

# Copy package.json for npx
COPY package.json ./

EXPOSE 3000
ENV PORT=3000
ENV NODE_ENV=production

CMD ["sh", "-c", "cd /app/libs/prisma-client/prisma && npx prisma db push --accept-data-loss && cd /app && node dist/main.js"]
