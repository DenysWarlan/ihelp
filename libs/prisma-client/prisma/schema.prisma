generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PERSON
  CONSULTANT
  SUPERVISOR
  COORDINATOR
  ADMIN
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  role      Role     @default(PERSON)
  avatarUrl String?  @map("avatar_url")
  timezone  String   @default("UTC")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Auth: password for Staff (S-E01-06)
  passwordHash String? @map("password_hash")

  // GDPR consent (S-E01-07)
  dataConsentAt          DateTime? @map("data_consent_at")
  sensitiveDataConsentAt DateTime? @map("sensitive_data_consent_at")

  // MFA (S-E01-08)
  mfaSecret     String?  @map("mfa_secret")
  mfaEnabled    Boolean  @default(false) @map("mfa_enabled")
  mfaBackupHash String[] @default([]) @map("mfa_backup_hash")

  // Break-glass flag (S-E01-09)
  isBreakGlass Boolean @default(false) @map("is_break_glass")

  sessions      Session[]
  providerLinks ProviderLink[]
  invitesSent   Invite[]       @relation("inviter")

  // Cases relations
  careCasesAsPerson     CareCase[] @relation("CasePerson")
  careCasesAsConsultant CareCase[] @relation("CaseConsultant")
  caseNotes             CaseNote[] @relation("NoteAuthor")

  // Chat relations
  messagesSent Message[] @relation("MessageSender")

  // LMS relations
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  progressResets ProgressReset[]

  // Assignment relations
  consultantProfile ConsultantProfile?

  // Meetings relations
  meetingsAsConsultant Meeting[] @relation("MeetingConsultant")
  meetingsAsPerson     Meeting[] @relation("MeetingPerson")

  // Duty schedule
  dutySchedules DutySchedule[]

  // Transfer relations
  transfersFrom CaseTransfer[] @relation("TransferFrom")
  transfersTo   CaseTransfer[] @relation("TransferTo")

  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String
  tokenFamily  String?  @map("token_family")
  isRevoked    Boolean  @default(false) @map("is_revoked")
  isCrisis     Boolean  @default(false) @map("is_crisis")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([tokenFamily])
  @@map("sessions")
}

// S-E01-02/03: OAuth provider links for multi-provider accounts
model ProviderLink {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("provider_links")
}

// S-E01-06: Staff invite tokens
model Invite {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  role      Role
  token     String    @unique
  inviterId String    @map("inviter_id") @db.Uuid
  claimedAt DateTime? @map("claimed_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  inviter User @relation("inviter", fields: [inviterId], references: [id])

  @@index([token])
  @@index([email])
  @@map("invites")
}

// S-E01-09: Audit log for security events
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  details   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// CARE CASES — Enums
// ============================================================

enum CaseStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  MEETING_SCHEDULED
  ON_HOLD
  TRANSFERRED
  COMPLETED
  CLOSED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRISIS
}

enum CrisisLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseSource {
  WEBSITE_FORM
  COURSE
  TELEGRAM
  INSTAGRAM
  FACEBOOK
  VIBER
  REFERRAL
  MANUAL
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum LessonContentType {
  TEXT
  VIDEO
  MIXED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

model Course {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String
  status      CourseStatus @default(DRAFT)
  imageUrl    String?      @map("image_url")
  language    String?
  tags        String[]     @default([])
  lessonCount Int          @default(0) @map("lesson_count")
  gracePeriodEnd DateTime? @map("grace_period_end")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  lessons     Lesson[]
  careCases   CareCase[]
  enrollments Enrollment[]

  @@index([status])
  @@map("courses")
}

model Lesson {
  id                String            @id @default(uuid()) @db.Uuid
  courseId           String            @map("course_id") @db.Uuid
  title             String
  content           String            @default("")
  contentType       LessonContentType @default(TEXT) @map("content_type")
  videoUrl          String?           @map("video_url")
  sortOrder         Int               @default(0) @map("sort_order")
  hasTriggerWarning Boolean           @default(false) @map("has_trigger_warning")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([courseId])
  @@map("lessons")
}

// ============================================================
// ENROLLMENT (course enrollment for Persons)
// ============================================================

model Enrollment {
  id        String           @id @default(uuid()) @db.Uuid
  personId  String           @map("person_id") @db.Uuid
  courseId   String           @map("course_id") @db.Uuid
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  person User   @relation(fields: [personId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([personId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

// ============================================================
// CARE CASES
// ============================================================

model CareCase {
  id              String       @id @default(uuid()) @db.Uuid
  personId        String       @map("person_id") @db.Uuid
  consultantId    String?      @map("consultant_id") @db.Uuid
  status          CaseStatus   @default(NEW)
  priority        CasePriority @default(MEDIUM)
  crisisLevel     CrisisLevel  @default(NONE)
  source          CaseSource   @default(WEBSITE_FORM)
  topic           String
  description     String?
  name            String?      // Person's name from intake form
  country         String?
  language        String?
  contactMethod   String?      @map("contact_method")
  contactValue    String?      @map("contact_value")
  sourceCourseId  String?      @map("source_course_id") @db.Uuid
  sourceLessonId  String?      @map("source_lesson_id") @db.Uuid
  firstResponseAt DateTime?    @map("first_response_at")
  resolvedAt      DateTime?    @map("resolved_at")
  closedAt        DateTime?    @map("closed_at")
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  person       User     @relation("CasePerson", fields: [personId], references: [id], onDelete: Restrict)
  consultant   User?    @relation("CaseConsultant", fields: [consultantId], references: [id])
  sourceCourse Course?  @relation(fields: [sourceCourseId], references: [id], onDelete: SetNull)
  notes        CaseNote[]
  auditEntries CaseAuditEntry[]
  messages     Message[]
  feedback     CaseFeedback?
  tags         CaseTag[]
  meetings     Meeting[]
  slaTimer     SlaTimer?
  transfers    CaseTransfer[]

  @@index([status])
  @@index([consultantId])
  @@index([personId])
  @@index([priority])
  @@index([crisisLevel])
  @@index([createdAt])
  @@index([status, consultantId])
  @@map("care_cases")
}

// ============================================================
// CASE NOTES (приватні нотатки консультанта)
// ============================================================

model CaseNote {
  id               String   @id @default(uuid()) @db.Uuid
  careCaseId       String   @map("care_case_id") @db.Uuid
  authorId         String   @map("author_id") @db.Uuid
  content          String
  isSupervisorNote Boolean  @default(false) @map("is_supervisor_note")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  careCase CareCase @relation(fields: [careCaseId], references: [id], onDelete: Cascade)
  author   User     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([careCaseId, createdAt])
  @@index([authorId])
  @@map("case_notes")
}

// ============================================================
// CASE AUDIT LOG (append-only)
// ============================================================

model CaseAuditEntry {
  id         String   @id @default(uuid()) @db.Uuid
  careCaseId String   @map("care_case_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  careCase CareCase @relation(fields: [careCaseId], references: [id], onDelete: Cascade)

  @@index([careCaseId, createdAt])
  @@index([actorId])
  @@index([action])
  @@map("case_audit_entries")
}

// ============================================================
// MESSAGES (unified omnichannel)
// ============================================================

enum MessageChannel {
  WEB
  TELEGRAM
  INSTAGRAM
  FACEBOOK
  VIBER
}

model Message {
  id            String         @id @default(uuid()) @db.Uuid
  careCaseId    String         @map("care_case_id") @db.Uuid
  senderId      String         @map("sender_id") @db.Uuid
  senderRole    Role           @map("sender_role")
  channel       MessageChannel @default(WEB)
  channelChatId String?        @map("channel_chat_id")
  channelMsgId  String?        @map("channel_msg_id")
  content       String?        @db.VarChar(10000)
  attachments   Json?
  isRead        Boolean        @default(false) @map("is_read")
  isEdited      Boolean        @default(false) @map("is_edited")
  isDeleted     Boolean        @default(false) @map("is_deleted")
  deletedAt     DateTime?      @map("deleted_at")
  originalTs    DateTime?      @map("original_ts")
  readAt        DateTime?      @map("read_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  careCase CareCase         @relation(fields: [careCaseId], references: [id], onDelete: Cascade)
  sender   User             @relation("MessageSender", fields: [senderId], references: [id])
  versions MessageVersion[]

  @@index([careCaseId, createdAt])
  @@index([senderId])
  @@index([channel, channelChatId])
  @@index([channel, channelMsgId])
  @@index([careCaseId, isRead])
  @@map("messages")
}

// ============================================================
// MESSAGE VERSION (append-only edit/delete history)
// ============================================================

model MessageVersion {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  version   Int
  content   String?  @db.VarChar(10000)
  editedAt  DateTime @default(now()) @map("edited_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, version])
  @@index([messageId])
  @@map("message_versions")
}

// ============================================================
// CASE FEEDBACK
// ============================================================

model CaseFeedback {
  id         String   @id @default(uuid()) @db.Uuid
  careCaseId String   @unique @map("care_case_id") @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  careCase CareCase @relation(fields: [careCaseId], references: [id], onDelete: Cascade)

  @@map("case_feedbacks")
}

// ============================================================
// TAGS (case categorization)
// ============================================================

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")

  cases CaseTag[]

  @@map("tags")
}

model CaseTag {
  id         String   @id @default(uuid()) @db.Uuid
  careCaseId String   @map("care_case_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  careCase CareCase @relation(fields: [careCaseId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([careCaseId, tagId])
  @@index([tagId])
  @@map("case_tags")
}

// ============================================================
// LESSON PROGRESS (per-person per-lesson completion)
// ============================================================

model LessonProgress {
  id          String    @id @default(uuid()) @db.Uuid
  personId    String    @map("person_id") @db.Uuid
  lessonId    String    @map("lesson_id") @db.Uuid
  courseId     String    @map("course_id") @db.Uuid
  isCompleted Boolean   @default(false) @map("is_completed")
  isSkipped   Boolean   @default(false) @map("is_skipped")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  person User   @relation(fields: [personId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([personId, lessonId])
  @@index([personId, courseId])
  @@map("lesson_progress")
}

// ============================================================
// PROGRESS RESET (tracks reset count per enrollment)
// ============================================================

model ProgressReset {
  id        String   @id @default(uuid()) @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  resetAt   DateTime @default(now()) @map("reset_at")

  person User @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, courseId])
  @@map("progress_resets")
}

// ============================================================
// CONSULTANT PROFILE (assignment algorithm data)
// ============================================================

enum ConsultantStatus {
  AVAILABLE
  BUSY
  ON_VACATION
  DEACTIVATED
  LEAVING
}

model ConsultantProfile {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @unique @map("user_id") @db.Uuid
  specializations String[]         @default([])
  languages       String[]         @default([])
  maxCases        Int              @default(10) @map("max_cases")
  currentCases    Int              @default(0) @map("current_cases")
  maxCrisisCases  Int              @default(3) @map("max_crisis_cases")
  currentCrisis   Int              @default(0) @map("current_crisis")
  status          ConsultantStatus @default(AVAILABLE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([status, currentCases])
  @@map("consultant_profiles")
}

// ============================================================
// MEETINGS
// ============================================================

enum MeetingStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW_PERSON
  NO_SHOW_CONSULTANT
}

model Meeting {
  id            String        @id @default(uuid()) @db.Uuid
  careCaseId    String        @map("care_case_id") @db.Uuid
  consultantId  String        @map("consultant_id") @db.Uuid
  personId      String        @map("person_id") @db.Uuid
  status        MeetingStatus @default(SCHEDULED)
  scheduledAt   DateTime      @map("scheduled_at")
  durationMin   Int           @default(60) @map("duration_min")
  personTz      String        @default("UTC") @map("person_tz")
  consultantTz  String        @default("UTC") @map("consultant_tz")
  meetingUrl    String?       @map("meeting_url")
  notes         String?
  cancelledAt   DateTime?     @map("cancelled_at")
  cancelReason  String?       @map("cancel_reason")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  careCase   CareCase @relation(fields: [careCaseId], references: [id], onDelete: Cascade)
  consultant User     @relation("MeetingConsultant", fields: [consultantId], references: [id])
  person     User     @relation("MeetingPerson", fields: [personId], references: [id])

  @@index([careCaseId])
  @@index([consultantId, scheduledAt])
  @@index([personId])
  @@index([status])
  @@map("meetings")
}

// ============================================================
// SLA TIMER
// ============================================================

enum SlaStatus {
  ACTIVE
  PAUSED
  ESCALATED
  RESOLVED
}

model SlaTimer {
  id              String    @id @default(uuid()) @db.Uuid
  careCaseId      String    @map("care_case_id") @db.Uuid
  startedAt       DateTime  @map("started_at")
  pausedAt        DateTime? @map("paused_at")
  resolvedAt      DateTime? @map("resolved_at")
  currentLevel    Int       @default(0) @map("current_level")
  status          SlaStatus @default(ACTIVE)
  lastEscalatedAt DateTime? @map("last_escalated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  careCase CareCase @relation(fields: [careCaseId], references: [id], onDelete: Cascade)

  @@unique([careCaseId])
  @@index([status])
  @@index([status, currentLevel])
  @@map("sla_timers")
}

// ============================================================
// RESPONSE TIME LOG (S-E07-03 — message response tracking)
// ============================================================

model ResponseTimeLog {
  id              String   @id @default(uuid()) @db.Uuid
  careCaseId      String   @map("care_case_id") @db.Uuid
  personMessageId String   @map("person_message_id") @db.Uuid
  consultantMessageId String? @map("consultant_message_id") @db.Uuid
  consultantId    String?  @map("consultant_id") @db.Uuid
  personSentAt    DateTime @map("person_sent_at")
  consultantRepliedAt DateTime? @map("consultant_replied_at")
  responseTimeMs  Int?     @map("response_time_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([careCaseId])
  @@index([consultantId])
  @@index([careCaseId, personSentAt])
  @@map("response_time_logs")
}

// ============================================================
// CRISIS KEYWORDS (S-E08-01/02 — configurable keyword list)
// ============================================================

enum CrisisRiskLevel {
  LOW
  MEDIUM
  HIGH
}

model CrisisKeyword {
  id        String          @id @default(uuid()) @db.Uuid
  keyword   String
  language  String          @default("uk")
  riskLevel CrisisRiskLevel @default(HIGH) @map("risk_level")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([keyword, language])
  @@index([isActive])
  @@index([riskLevel])
  @@map("crisis_keywords")
}

// ============================================================
// CRISIS AUTO-REPLY TEMPLATE (S-E08-04 — configurable auto-reply)
// ============================================================

model CrisisAutoReply {
  id        String   @id @default(uuid()) @db.Uuid
  language  String   @unique @default("uk")
  template  String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crisis_auto_replies")
}

// ============================================================
// CRISIS ALERT LOG (S-E08-03 — escalation tracking)
// ============================================================

model CrisisAlert {
  id              String          @id @default(uuid()) @db.Uuid
  careCaseId      String          @map("care_case_id") @db.Uuid
  messageId       String          @map("message_id") @db.Uuid
  riskLevel       CrisisRiskLevel @map("risk_level")
  matchedKeywords String[]        @default([]) @map("matched_keywords")
  acknowledgedAt  DateTime?       @map("acknowledged_at")
  acknowledgedBy  String?         @map("acknowledged_by") @db.Uuid
  autoReplySent   Boolean         @default(false) @map("auto_reply_sent")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([careCaseId])
  @@index([riskLevel])
  @@index([acknowledgedAt])
  @@map("crisis_alerts")
}

// ============================================================
// DUTY SCHEDULE (S-E08-07/08 — night duty routing)
// ============================================================

model DutySchedule {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([startTime, endTime])
  @@index([userId])
  @@index([isActive])
  @@map("duty_schedules")
}

// ============================================================
// CASE TRANSFER (S-E10-01/02 — transfer tracking)
// ============================================================

enum TransferType {
  VACATION
  PERMANENT
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
  RETURNED
}

model CaseTransfer {
  id                    String         @id @default(uuid()) @db.Uuid
  careCaseId            String         @map("care_case_id") @db.Uuid
  fromConsultantId      String         @map("from_consultant_id") @db.Uuid
  toConsultantId        String?        @map("to_consultant_id") @db.Uuid
  transferType          TransferType   @map("transfer_type")
  status                TransferStatus @default(PENDING)
  vacationStart         DateTime?      @map("vacation_start")
  vacationEnd           DateTime?      @map("vacation_end")
  reason                String?
  completedAt           DateTime?      @map("completed_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  careCase        CareCase @relation(fields: [careCaseId], references: [id], onDelete: Cascade)
  fromConsultant  User     @relation("TransferFrom", fields: [fromConsultantId], references: [id])
  toConsultant    User?    @relation("TransferTo", fields: [toConsultantId], references: [id])

  @@index([careCaseId])
  @@index([fromConsultantId])
  @@index([toConsultantId])
  @@index([status])
  @@index([transferType, status])
  @@map("case_transfers")
}

// ============================================================
// ORGANIZATION SETTINGS (business hours for duty routing)
// ============================================================

model OrganizationSettings {
  id                String   @id @default(uuid()) @db.Uuid
  key               String   @unique
  value             String
  description       String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("organization_settings")
}
