generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PERSON
  CONSULTANT
  SUPERVISOR
  COORDINATOR
  ADMIN
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  role      Role     @default(PERSON)
  avatarUrl String?  @map("avatar_url")
  timezone  String   @default("UTC")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Auth: password for Staff (S-E01-06)
  passwordHash String? @map("password_hash")

  // GDPR consent (S-E01-07)
  dataConsentAt          DateTime? @map("data_consent_at")
  sensitiveDataConsentAt DateTime? @map("sensitive_data_consent_at")

  // MFA (S-E01-08)
  mfaSecret     String?  @map("mfa_secret")
  mfaEnabled    Boolean  @default(false) @map("mfa_enabled")
  mfaBackupHash String[] @default([]) @map("mfa_backup_hash")

  // Break-glass flag (S-E01-09)
  isBreakGlass Boolean @default(false) @map("is_break_glass")

  sessions      Session[]
  providerLinks ProviderLink[]
  invitesSent   Invite[]       @relation("inviter")

  // Cases relations
  careCasesAsPerson     CareCase[] @relation("CasePerson")
  careCasesAsConsultant CareCase[] @relation("CaseConsultant")
  caseNotes             CaseNote[] @relation("NoteAuthor")

  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String
  tokenFamily  String?  @map("token_family")
  isRevoked    Boolean  @default(false) @map("is_revoked")
  isCrisis     Boolean  @default(false) @map("is_crisis")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([tokenFamily])
  @@map("sessions")
}

// S-E01-02/03: OAuth provider links for multi-provider accounts
model ProviderLink {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("provider_links")
}

// S-E01-06: Staff invite tokens
model Invite {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  role      Role
  token     String    @unique
  inviterId String    @map("inviter_id") @db.Uuid
  claimedAt DateTime? @map("claimed_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  inviter User @relation("inviter", fields: [inviterId], references: [id])

  @@index([token])
  @@index([email])
  @@map("invites")
}

// S-E01-09: Audit log for security events
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  details   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// CARE CASES — Enums
// ============================================================

enum CaseStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  MEETING_SCHEDULED
  ON_HOLD
  TRANSFERRED
  COMPLETED
  CLOSED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRISIS
}

enum CrisisLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseSource {
  WEBSITE_FORM
  COURSE
  TELEGRAM
  INSTAGRAM
  FACEBOOK
  VIBER
  REFERRAL
  MANUAL
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

model Course {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String
  status      CourseStatus @default(DRAFT)
  imageUrl    String?      @map("image_url")
  tags        String[]     @default([])
  lessonCount Int          @default(0) @map("lesson_count")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  lessons   Lesson[]
  careCases CareCase[]

  @@index([status])
  @@map("courses")
}

model Lesson {
  id        String   @id @default(uuid()) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  title     String
  content   String   @default("")
  videoUrl  String?  @map("video_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("lessons")
}

// ============================================================
// CARE CASES
// ============================================================

model CareCase {
  id              String       @id @default(uuid()) @db.Uuid
  personId        String       @map("person_id") @db.Uuid
  consultantId    String?      @map("consultant_id") @db.Uuid
  status          CaseStatus   @default(NEW)
  priority        CasePriority @default(MEDIUM)
  crisisLevel     CrisisLevel  @default(NONE)
  source          CaseSource   @default(WEBSITE_FORM)
  topic           String
  description     String?
  name            String?      // Person's name from intake form
  country         String?
  language        String?
  contactMethod   String?      @map("contact_method")
  contactValue    String?      @map("contact_value")
  sourceCourseId  String?      @map("source_course_id") @db.Uuid
  sourceLessonId  String?      @map("source_lesson_id") @db.Uuid
  firstResponseAt DateTime?    @map("first_response_at")
  resolvedAt      DateTime?    @map("resolved_at")
  closedAt        DateTime?    @map("closed_at")
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  person       User     @relation("CasePerson", fields: [personId], references: [id], onDelete: Restrict)
  consultant   User?    @relation("CaseConsultant", fields: [consultantId], references: [id])
  sourceCourse Course?  @relation(fields: [sourceCourseId], references: [id], onDelete: SetNull)
  notes        CaseNote[]
  auditEntries CaseAuditEntry[]

  @@index([status])
  @@index([consultantId])
  @@index([personId])
  @@index([priority])
  @@index([crisisLevel])
  @@index([createdAt])
  @@index([status, consultantId])
  @@map("care_cases")
}

// ============================================================
// CASE NOTES (приватні нотатки консультанта)
// ============================================================

model CaseNote {
  id               String   @id @default(uuid()) @db.Uuid
  careCaseId       String   @map("care_case_id") @db.Uuid
  authorId         String   @map("author_id") @db.Uuid
  content          String
  isSupervisorNote Boolean  @default(false) @map("is_supervisor_note")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  careCase CareCase @relation(fields: [careCaseId], references: [id], onDelete: Cascade)
  author   User     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([careCaseId, createdAt])
  @@index([authorId])
  @@map("case_notes")
}

// ============================================================
// CASE AUDIT LOG (append-only)
// ============================================================

model CaseAuditEntry {
  id         String   @id @default(uuid()) @db.Uuid
  careCaseId String   @map("care_case_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  careCase CareCase @relation(fields: [careCaseId], references: [id], onDelete: Cascade)

  @@index([careCaseId, createdAt])
  @@index([actorId])
  @@index([action])
  @@map("case_audit_entries")
}
