# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=ihelp
POSTGRES_PASSWORD=ihelp_secret
POSTGRES_DB=ihelp
DATABASE_URL=postgresql://ihelp:ihelp_secret@localhost:5433/ihelp

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-secret

# ── S3 / MinIO ─────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ihelp-uploads
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Google OAuth ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8888/api/auth/google/callback
FRONTEND_URL=http://localhost:4333

# ── Security ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:4333
